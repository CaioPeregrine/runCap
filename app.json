{
  "expo": {
    "name": "runCap",
    "slug": "runcap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "runcap",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runcap.app",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O runCap precisa da sua localização para narrar pontos turísticos mesmo com a tela bloqueada.",
        "NSLocationWhenInUseUsageDescription": "O runCap usa sua localização para registrar sua corrida.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.runcap.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "config": {
      "googleMaps": {
        "apiKey": "AIzaSyAKJrk8lYlpZ6Rk_j3DEtpaehtrFSqtCTg"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O runCap precisa da sua localização para narrar pontos turísticos mesmo com a tela bloqueada.",
          "locationWhenInUsePermission": "O runCap usa sua localização para registrar sua corrida.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26a46c96-bc82-4286-b0af-55b1e4ed330c"
      }
    }
  }
}